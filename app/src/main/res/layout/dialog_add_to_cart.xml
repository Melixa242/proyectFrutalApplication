<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Nombre del producto -->
    <TextView
        android:id="@+id/dialogProductNameTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nombre del Producto"
        android:textColor="@color/colorPrimary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:gravity="center"/>

    <!-- Tipo de Precio -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo de Venta"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/priceTypeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/wholesaleRadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Por Mayor"
            android:textColor="@color/colorSecondary"
            android:buttonTint="@color/colorPrimary"
            android:checked="true"/>

        <RadioButton
            android:id="@+id/retailRadioButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Por Menor"
            android:textColor="@color/colorSecondary"
            android:buttonTint="@color/colorPrimary"/>

    </RadioGroup>

    <!-- Información de precios -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:background="#F5F5F5"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio Mayor"
                android:textColor="@color/colorSecondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/wholesalePriceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bs 0.00"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Precio Menor"
                android:textColor="@color/colorSecondary"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/retailPriceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bs 0.00"
                android:textColor="@color/colorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Cantidad -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cantidad"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/quantityEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_selector"
        android:hint="Cantidad a vender"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:text="1"
        android:textColor="@color/colorSecondary"
        android:textSize="16sp" />

    <!-- Precio (editable) -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Precio Unitario (Editable)"
        android:textColor="@color/colorPrimary"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/priceEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/edit_text_selector"
        android:hint="Bs 0.00"
        android:inputType="numberDecimal"
        android:padding="16dp"
        android:textColor="@color/colorSecondary"
        android:textSize="16sp"
        android:drawableStart="@drawable/ic_money"
        android:drawablePadding="8dp"/>

    <!-- Total -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mediumGray"
        android:layout_marginVertical="8dp"/>

    <TextView
        android:id="@+id/totalTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: Bs 0.00"
        android:textColor="@color/colorPrimary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="end"/>

</LinearLayout>