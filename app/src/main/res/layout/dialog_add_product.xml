<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/informaci_n_del_producto"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"
            android:drawableStart="@drawable/ic_fruit"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"/>

        <!-- Campo nombre de la fruta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nombre_de_la_fruta"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <AutoCompleteTextView
            android:id="@+id/fruitNameEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/edit_text_selector"
            android:hint="@string/fruit_name_hint"
            android:inputType="textCapWords"
            android:padding="16dp"
            android:textColor="@color/colorSecondary"
            android:textSize="16sp" />

        <!-- Cantidad y Medidas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cantidad_y_medidas"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Layout horizontal para cantidad y unidad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Campo cantidad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cantidad"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/quantityEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:hint="@string/quantity_hint"
                    android:inputType="numberDecimal"
                    android:padding="16dp"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Spinner de unidades -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/unidad"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/unitSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/spinner_background"
                    android:entries="@array/weight_units"
                    android:padding="16dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- SECCIÓN DE PRECIOS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/precios_de_venta"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="8dp" />

        <!-- Layout horizontal para precios -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Precio por Mayor -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/precio_por_mayor"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/wholesalePriceEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:hint="Bs 0.00"
                    android:inputType="numberDecimal"
                    android:padding="16dp"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp"
                    android:drawableStart="@drawable/ic_money"
                    android:drawablePadding="8dp" />

            </LinearLayout>

            <!-- Precio por Menor -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/precio_por_menor"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/retailPriceEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:hint="Bs 0.00"
                    android:inputType="numberDecimal"
                    android:padding="16dp"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp"
                    android:drawableStart="@drawable/ic_money"
                    android:drawablePadding="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Nota informativa sobre precios -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/precio_por_mayor_para_ventas_de_grandes_cantidades_n_precio_por_menor_para_ventas_al_detalle"
            android:textColor="@color/colorSecondary"
            android:textSize="12sp"
            android:textStyle="italic"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#F5F5F5"/>

        <!-- Campo fracción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fraction_label"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- RadioGroup para fracciones -->
        <RadioGroup
            android:id="@+id/fractionRadioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/fraction_quarter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_1_4"
                android:textColor="@color/colorSecondary"
                android:buttonTint="@color/colorPrimary" />

            <RadioButton
                android:id="@+id/fraction_half"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_1_2"
                android:textColor="@color/colorSecondary"
                android:buttonTint="@color/colorPrimary" />

            <RadioButton
                android:id="@+id/fraction_three_quarters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_3_4"
                android:textColor="@color/colorSecondary"
                android:buttonTint="@color/colorPrimary" />

        </RadioGroup>

        <RadioGroup
            android:id="@+id/fractionRadioGroup2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/fraction_one"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_1"
                android:textColor="@color/colorSecondary"
                android:buttonTint="@color/colorPrimary"
                android:checked="true" />

            <RadioButton
                android:id="@+id/fraction_one_half"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/kilomedio"
                android:textColor="@color/colorSecondary"
                android:buttonTint="@color/colorPrimary" />

            <RadioButton
                android:id="@+id/fraction_two"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/_2"
                android:textColor="@color/colorSecondary"
                android:buttonTint="@color/colorPrimary" />

        </RadioGroup>

        <!-- Fechas -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fechas_de_control"
            android:textColor="@color/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Layout horizontal para fechas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp" >

            <!-- Fecha de producción -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fecha_de_producci_n"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/productionDateEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:hint="@string/production_date_hint"
                    android:inputType="none"
                    android:padding="16dp"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp"
                    android:focusable="false"
                    android:clickable="true" />

            </LinearLayout>

            <!-- Fecha de vencimiento -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/fecha_de_vencimiento"
                    android:textColor="@color/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/expiryDateEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/edit_text_selector"
                    android:hint="@string/expiry_date_hint"
                    android:inputType="none"
                    android:padding="16dp"
                    android:textColor="@color/colorSecondary"
                    android:textSize="16sp"
                    android:focusable="false"
                    android:clickable="true"
                    tools:ignore="TextFields" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/observaciones_adicionales"
            android:textColor="@color/colorPrimary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/notesEditText"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/edit_text_selector"
            android:hint="@string/notes_hint"
            android:inputType="textMultiLine"
            android:padding="16dp"
            android:textColor="@color/colorSecondary"
            android:textSize="16sp"
            android:gravity="top|start"
            android:maxLines="4" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre de la fruta"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <AutoCompleteTextView
                android:id="@+id/fruitNameEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:completionThreshold="1"
                tools:ignore="DuplicateIds" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón para cargar información de API -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/loadFruitInfoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔍 Cargar Info Nutricional"
            android:backgroundTint="@color/colorAccent"
            android:textColor="@android:color/white"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            tools:ignore="HardcodedText" />

    </LinearLayout>

</ScrollView>